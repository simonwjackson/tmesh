{
  "name": "tmesh",
  "version": "0.1.0",
  "description": "Effortlessly manage tmux sessions across multiple hosts",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "tmesh": "src/cli.ts",
    "server-select": "src/server-select.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --compile --outfile=dist/tmesh && bun build src/server-select.ts --compile --outfile=dist/server-select",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "bun x tsc --noEmit"
  },
  "keywords": [
    "tmux",
    "mosh",
    "ssh",
    "terminal",
    "multiplexer",
    "session-management"
  ],
  "author": "Simon W. Jackson",
  "license": "GPL-2.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/simonwjackson/tmesh"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  }
}
